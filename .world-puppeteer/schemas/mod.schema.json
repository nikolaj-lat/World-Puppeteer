{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-puppeteer.local/schemas/mod.schema.json",
  "title": "World Puppeteer Mod Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "compatibleFormats",
    "domains",
    "supportedModes",
    "defaultMode",
    "applicationProfile",
    "conflictPolicy",
    "dependencies",
    "optionalDependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "compatibleFormats": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "domains": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "supportedModes": { "type": "array", "items": { "enum": ["reference", "apply"] }, "uniqueItems": true },
    "defaultMode": { "enum": ["reference", "apply"] },
    "applicationProfile": { "enum": ["reference-only", "additive", "structured-merge", "template-copy", "manual"] },
    "conflictPolicy": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "optionalDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
