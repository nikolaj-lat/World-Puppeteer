{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-puppeteer.local/schemas/mod.schema.json",
  "title": "World Puppeteer Mod Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "description", "compatibleFormats", "domains", "supportedModes", "defaultMode", "applicationProfile", "conflictPolicy", "dependencies", "optionalDependencies", "files", "payloadMappings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "compatibleFormats": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "domains": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "supportedModes": { "type": "array", "items": { "enum": ["reference", "apply"] }, "minItems": 1, "uniqueItems": true },
    "defaultMode": { "enum": ["reference", "apply"] },
    "applicationProfile": { "enum": ["reference-only", "additive", "structured-merge", "template-copy", "manual"] },
    "conflictPolicy": { "enum": ["stop"] },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
    "optionalDependencies": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "payloadMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "sourcePath", "targetPath", "preferredTargetFile", "domain"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "sourcePath": { "type": "string", "minLength": 1 },
          "targetPath": { "type": "string", "minLength": 1 },
          "preferredTargetFile": { "type": "string", "pattern": "\\.json$" },
          "domain": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
